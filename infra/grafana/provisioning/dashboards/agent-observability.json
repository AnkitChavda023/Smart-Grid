{
  "title": "SmartGrid Agent Observability",
  "uid": "smartgrid-agents",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Tool Calls per Agent (rate/5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (agent, tool) (rate(agent_tool_calls_total[5m]))",
          "legendFormat": "{{agent}} / {{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Average Confidence Score per Agent",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (agent) (rate(agent_confidence_score_sum[5m])) / sum by (agent) (rate(agent_confidence_score_count[5m]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Escalations per Agent (rate/5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (agent) (rate(agent_escalation_total[5m]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Average Latency per Agent (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (agent) (rate(agent_latency_seconds_sum[5m])) / sum by (agent) (rate(agent_latency_seconds_count[5m]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Agents Reporting (up)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"smartgrid-agents\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
